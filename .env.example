# No credentials are needed for Phase 1. These optional settings are read by config.py.
READMITIQ_CONFIG=configs/config.yaml
READMITIQ_LOG_LEVEL=INFO
# Copy to .env for reference, then export variables in your shell if overriding defaults.
# The application does not automatically load .env files.
# Phase 6 local overrides (normally the defaults are sufficient).
READMITIQ_API_URL=http://127.0.0.1:8000
READMITIQ_MODEL_PATH=models/final/readmit_iq_logistic.joblib
